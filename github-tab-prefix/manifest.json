{
  "manifest_version": 3,
  "name": "GitHub Tab Prefix",
  "description": "GitHub のタブタイトル先頭にリポジトリ名を付ける（conventional commit のスコープも）",
  "version": "1.1.0",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
