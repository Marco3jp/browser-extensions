{
  "manifest_version": 3,
  "name": "Highlight Crawlable Anchors",
  "version": "1.0.0",
  "description": "robots.txt・nofollow・noindexを参照してクロールされうるリンクをハイライト表示します",
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Highlight Crawlable Anchors"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
