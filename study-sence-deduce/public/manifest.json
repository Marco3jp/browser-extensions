{
  "manifest_version": 3,
  "name": "study-sence-deduce",
  "version": "0.1.0",
  "description": "dev/stg/prod を行き来する開発作業を快適にするための小道具集（環境リボン・スイッチャー・テンプレURL）",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "study-sence-deduce"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["templates.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
